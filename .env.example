# Copy to .env for local development. Never commit .env.
# Use the same managed PostgreSQL database for local and hosted backends.
# Put the real connection string in your local .env and hosting secret settings.
DATABASE_URL=postgresql+psycopg://imi_user:CHANGE_ME@YOUR_DB_HOST:5432/imi_market?sslmode=require

# Backend
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Market-data provider (keep the actual key private)
TWELVE_DATA_API_KEY=SET_LOCALLY
TWELVE_DATA_BASE_URL=https://api.twelvedata.com

# Data ingestion defaults
MARKET_DATA_MODE=historical_and_streaming
DEFAULT_TIMEFRAMES=1min,5min,15min,30min,1h,4h,1day,1week
INGESTION_ENABLED=false
